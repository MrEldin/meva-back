# The catalogue export's orders and customers carry personal data for ~4,000
# people and must never be committed. See database/seeders/data/README.md.
/database/seeders/data/orders.*
/database/seeders/data/order_items.*
/database/seeders/data/customers.*

# The cutouts are made as large PNGs and committed as the WebP the seeder
# reads; the originals stay on whoever generated them.
database/seeders/assets/images/**/*-bez-pozadine.png
.DS_Store
