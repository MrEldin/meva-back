APP_NAME=Meva
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=meva
DB_USERNAME=meva
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Campaigns go out through Resend. Leave MAIL_MAILER=log until the domain
# shows "verified" in Resend -- sending before SPF and DKIM are in place
# damages the domain's reputation, and that takes weeks to undo.
MAIL_MAILER=log
RESEND_KEY=
MAIL_FROM_ADDRESS="posta@meva.life"
MAIL_FROM_NAME="Meva Kozmetika"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

IMAGE_DRIVER=gd

# Point this at the exported orders.json/customers.json to seed the order
# archive. Those files hold personal data and are never committed.
MEVA_ARCHIVE_PATH=

# Where the storefront lives. Canonical links, share cards, the sitemap and the
# advert feed all point here.
STOREFRONT_URL=http://localhost:5173

# Seeded owner account.
ADMIN_EMAIL=admin@meva.life
ADMIN_FIRST_NAME=Meva
ADMIN_LAST_NAME=Admin
ADMIN_PASSWORD=

# Leave API_DOMAIN empty so Dingo matches API requests by the API_PREFIX below.
# Setting it makes Dingo treat every request to that host as an API request --
# including the Lunar admin panel, which then breaks with a 500 instead of
# redirecting to its login page.
API_DOMAIN=
API_CONDITIONAL_REQUEST=false
API_STANDARDS_TREE=vnd
API_SUBTYPE=Meva
API_PREFIX=api
API_VERSION=v1
API_NAME="Meva API"
API_STRICT=false
API_DEFAULT_FORMAT=json
API_DEBUG=true

JWT_SECRET=
# Admin sessions last a week; a token can be refreshed for thirty days.
JWT_TTL=10080
JWT_REFRESH_TTL=43200

# AI --------------------------------------------------------------------------
# The AI layer is inert until a provider key is set; tests never call out.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_CHEAPEST_MODEL=claude-haiku-4-5
ANTHROPIC_SMARTEST_MODEL=claude-opus-5

# Other providers: set AI_PROVIDER to one of these and fill in its key.
# DEEPSEEK_API_KEY=
# KIMI_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_URL=http://localhost:11434/v1

ALLOWED_ORIGINS=*
